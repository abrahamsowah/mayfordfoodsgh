# Mayford Foods GH server configuration (TypeScript).
# Copy this file to `.env` and adjust as needed.
# Every value here mirrors the old PHP config defaults, now in the TS world.

# --- MySQL database ---
# These match the original site's connection settings (database.php values).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mayfordfoodsgh

# --- Demo mode ---
# auto  = use MySQL, fall back to the built-in SQLite demo database if unreachable
# force = always use SQLite demo mode (data resets each restart)
# off   = never fall back; fail if MySQL is unreachable
DEMO_MODE=auto

# --- HTTP ---
PORT=4000

# --- Security ---
# Admin PIN for the dashboard (leave unset to use the PIN stored in settings).
# ADMIN_PIN=1234
# Secret used to sign session cookies. Set a long random string in production.
# SESSION_SECRET=change-me-to-a-long-random-string

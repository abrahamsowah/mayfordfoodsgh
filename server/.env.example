# =====================================================================
#  MAYFORD FOODS GH - CLOUD PRODUCTION ENVIRONMENT CONFIGURATION
# =====================================================================

# --- Server Port ---
PORT=4000

# --- 1. Supabase (PostgreSQL Database Engine) ---
# Retrieve from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Anon Key: used for public storefront and client queries subject to RLS
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role Key: used for server API backend operations (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Direct PostgreSQL Connection String (from Supabase -> Database -> URI)
# DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# --- 2. Resend (Transactional & Branded Email Delivery) ---
# Retrieve from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Mayford Foods GH <orders@mayfordfoodsgh.com>

# --- 3. Paystack Payment Gateway (Ghana GHS) ---
# Retrieve from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key

# --- 4. Security Secrets & Session Store ---
ADMIN_PIN=mayford2026
SESSION_SECRET=your-production-session-secret-32-chars-minimum
PAYMENT_SIGNING_SECRET=your-hmac-sha256-signing-secret

# --- 5. Sajama Shield telemetry (optional standalone service) ---
# Server-to-server base URL; the browser beacon uses the same-origin /api/shield/telemetry route.
# For a separately hosted Shield service, use its internal/public API base ending in /api/shield.
SAJAMA_SHIELD_API_BASE_URL=http://127.0.0.1:5000/api/shield

# --- 6. Database Fallback (Optional) ---
DEMO_MODE=auto

# Optional SMS Providers (Ghana)
ARKESEL_API_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
SMS_SENDER_ID=MayfordGH

# Mayford Foods GH server configuration.
# Copy this file to `.env` and adjust as needed. Never commit the real .env.

# --- MySQL database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mayfordfoodsgh

# --- Demo mode ---
# auto  = use MySQL, fall back to the built-in SQLite demo database if unreachable
# force = always use SQLite demo mode (not for production)
# off   = never fall back; fail if MySQL is unreachable
DEMO_MODE=auto

# --- HTTP ---
PORT=4000
# Public URL of the site — used for tracking links, password-reset emails and
# the Paystack callback. No trailing slash.
APP_URL=http://localhost:5173
# Extra browser origins allowed to call the API (comma separated).
# Same-origin calls are always allowed.
# ALLOWED_ORIGINS=https://mayfordfoodsgh.com,https://www.mayfordfoodsgh.com
# Public URL of the API itself (used to show the webhook URL in the admin UI).
# PUBLIC_API_URL=https://mayfordfoodsgh.com

# --- Security ---
# PIN that unlocks the admin console. CHANGE THIS in production.
ADMIN_PIN=mayford2026
# Secret used to sign session cookies (32+ random characters).
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Salt used when hashing visitor IPs for analytics.
# IP_HASH_SALT=another-long-random-string
# Set to "production" on the live server: enables HSTS + a strict CSP and
# hides internal error details.
# NODE_ENV=production

# --- Payments (Paystack) ---
# Get these from the Paystack dashboard → Settings → API Keys & Webhooks.
# Without them the site runs fine and simply offers "pay on delivery".
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Where Paystack returns the customer after payment (defaults to APP_URL/track).
# PAYSTACK_CALLBACK_URL=https://mayfordfoodsgh.com/track

# --- Email notifications (optional) ---
# Orders, payments and status changes are always stored in the notifications
# table; add SMTP to actually deliver them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mayford Foods GH <no-reply@mayfordfoodsgh.com>"

# --- Store defaults (optional; the admin Settings page overrides these) ---
# DELIVERY_FEE=15

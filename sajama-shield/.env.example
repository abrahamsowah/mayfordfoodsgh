# Local standalone Sajama Shield configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=5000

# Change this before production use; production startup rejects the development default.
SAJAMA_SHIELD_KEY=replace-with-a-long-random-master-key
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Optional global fallback origins for telemetry (applies to every registered site).
# Prefer per-site Origins settings in the Shield dashboard; do not add ordinary client domains here.
# If needed, enter exact origins separated by commas, with no paths or trailing slashes.
CORS_ORIGINS=

# Optional: required only for the Node client SDK's /ingest and POST /logs endpoints.
SAJAMA_SHIELD_TOKEN=replace-with-a-separate-long-random-agent-token
